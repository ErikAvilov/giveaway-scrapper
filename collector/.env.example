# Neon pooled connection string (use the pooler host for app traffic)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini (required for analyze / pipeline / worker — not for db-init/crawl/stats)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Micro-batching: up to N giveaways per generate_content call
GEMINI_BATCH_SIZE=10
# Process-level cap (stay under free-tier RPM)
GEMINI_MAX_REQUESTS_PER_MINUTE=6

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Crawler (Raspberry Pi 5 defaults)
CRAWL_CONCURRENT_REQUESTS=2
CRAWL_CONCURRENT_REQUESTS_PER_DOMAIN=1
CRAWL_DOWNLOAD_DELAY=1.0
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES_PER_SOURCE=40
CRAWL_REQUEST_TIMEOUT=20
CRAWL_RETRIES=2
CRAWL_AUTOTHROTTLE=true
CRAWL_CANDIDATE_THRESHOLD=0.45
CRAWL_RAW_EXCERPT_MAX_CHARS=3000
# Gleam public directory listing pages (popular/newest/ending/odds × pagination)
GLEAM_DIRECTORY_MAX_PAGES=5

# Continuous worker
WORKER_IDLE_SLEEP_SECONDS=60
WORKER_ERROR_SLEEP_SECONDS=30
WORKER_ANALYZE_LIMIT=25
WORKER_HEARTBEAT_PATH=/tmp/collector_heartbeat

# Optional: Gleam enter bot (desktop Selenium — never on the Pi worker)
# GLEAM_BOT_ROOT=/absolute/path/to/Gleam-giveaway-bot
